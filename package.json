{
  "name": "cheapa",
  "private": true,
  "description": "Snap or share a product photo, see every Nigerian online listing for it, cheapest first.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env --profile app down",
    "infra:reset": "docker compose -f infra/docker-compose.yml --env-file .env --profile app down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "infra:check": "bash infra/check.sh",
    "test:down": "node scripts/test-down.mjs",
    "db:seed": "turbo run db:seed",
    "infra:up:app": "docker compose -f infra/docker-compose.yml --env-file .env --profile app up -d --build --wait",
    "crawl:report": "pnpm --filter @cheapa/worker crawl:report"
  },
  "prettier": "@cheapa/config/prettier",
  "devDependencies": {
    "@cheapa/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
