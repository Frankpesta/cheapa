# Copy to .env and fill in. Every new variable must be added here (CLAUDE.md rule 8).
# Loaded and validated by the zod fragments in packages/core/src/env.ts.
# The same file feeds docker compose (pnpm infra:up).

# --- base (all apps) ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Postgres container (infra/docker-compose.yml) ---
# Superuser: only used by the init script and admin tasks, never by apps.
POSTGRES_PASSWORD=change-me-superuser
# Role passwords, set once on first start of an empty volume (pnpm infra:reset to change).
# Must match the passwords inside the two URLs below.
CATALOG_DB_PASSWORD=change-me-catalog
USERS_DB_PASSWORD=change-me-users
# Change (e.g. 5433) if a local Postgres already uses 5432, and update both URLs below.
POSTGRES_PORT=5432
# Tuning: local defaults; VPS (8 GB) uses 2GB / 6GB / 512MB / 32MB.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAINTENANCE_WORK_MEM=256MB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=100

# --- Postgres: two databases, separate roles (CLAUDE.md rule 2) ---
# Catalog: api, api-jobs, worker
CATALOG_DATABASE_URL=postgres://cheapa_catalog:change-me-catalog@localhost:5432/cheapa_catalog
# Users: api and api-jobs ONLY
USERS_DATABASE_URL=postgres://cheapa_app:change-me-users@localhost:5432/cheapa_users

# --- Redis: two instances ---
REDIS_QUEUE_PORT=6379
REDIS_CACHE_PORT=6380
REDIS_QUEUE_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=512mb
# Queue: BullMQ, events:price stream, rate limits (noeviction, AOF)
REDIS_QUEUE_URL=redis://localhost:6379
# Cache: search and lookup caches (allkeys-lru, no persistence)
REDIS_CACHE_URL=redis://localhost:6380

# --- API (apps/api) ---
API_PORT=8080
# Comma-separated web origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# true behind Caddy so request.ip is the real client
TRUST_PROXY=false
# Anonymous image searches per device per hour; per-IP backstop (carrier NAT)
RATE_LIMIT_IMAGE_PER_DEVICE_HOUR=20
RATE_LIMIT_IMAGE_PER_IP_HOUR=300
# Reported by /health
APP_VERSION=dev

# --- Clerk auth (08-user-side.md 8.3) ---
# Development instance keys (sk_test_..., PEM). Required when NODE_ENV=production;
# without them locally, signed-out requests still work and signed-in ones get 503.
# Dashboard -> API keys -> Secret keys
CLERK_SECRET_KEY=
# Dashboard -> API keys -> Show JWT public key (PEM). One line, \n between lines, in double quotes:
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
CLERK_JWT_KEY=
# Comma-separated origins allowed as the token "azp" (web app origins). Empty = skip the check.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Later, when /webhooks/clerk exists (needs a public URL): whsec_...
CLERK_WEBHOOK_SECRET=

# NODE_ENV for the api/api-jobs containers (pnpm infra:up:app). production needs the Clerk keys.
API_NODE_ENV=production

# --- Observability (01-foundation.md 1.7). EU regions. Empty = disabled. ---
# Sentry project "api" -> Settings -> Client Keys (DSN). EU DSNs end in .ingest.de.sentry.io
SENTRY_DSN_API=
# Sentry project "worker" (used once the worker lands in phase 02)
SENTRY_DSN_WORKER=
# Defaults to NODE_ENV when empty
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
# CI only, for source-map uploads (1.8). Never needed at runtime. Set it as the GitHub
# Actions secret SENTRY_AUTH_TOKEN (org token, scope project:releases), plus the repo
# variable SENTRY_ORG; the release job is skipped until both exist.
SENTRY_AUTH_TOKEN=
# PostHog project (EU cloud) -> Settings -> Project API key (phc_...)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Client keys for later phases (mobile 06, web 07). Public by design.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
