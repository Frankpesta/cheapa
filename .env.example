# Copy to .env and fill in. Every new variable must be added here (CLAUDE.md rule 8).
# Loaded and validated by the zod fragments in packages/core/src/env.ts.
# The same file feeds docker compose (pnpm infra:up).

# --- base (all apps) ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Postgres container (infra/docker-compose.yml) ---
# Superuser: only used by the init script and admin tasks, never by apps.
POSTGRES_PASSWORD=change-me-superuser
# Role passwords, set once on first start of an empty volume (pnpm infra:reset to change).
# Must match the passwords inside the two URLs below.
CATALOG_DB_PASSWORD=change-me-catalog
USERS_DB_PASSWORD=change-me-users
# Change (e.g. 5433) if a local Postgres already uses 5432, and update both URLs below.
POSTGRES_PORT=5432
# Tuning: local defaults; VPS (8 GB) uses 2GB / 6GB / 512MB / 32MB.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAINTENANCE_WORK_MEM=256MB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=100

# --- Postgres: two databases, separate roles (CLAUDE.md rule 2) ---
# Catalog: api, api-jobs, worker
CATALOG_DATABASE_URL=postgres://cheapa_catalog:change-me-catalog@localhost:5432/cheapa_catalog
# Users: api and api-jobs ONLY
USERS_DATABASE_URL=postgres://cheapa_app:change-me-users@localhost:5432/cheapa_users

# --- Redis: two instances ---
REDIS_QUEUE_PORT=6379
REDIS_CACHE_PORT=6380
REDIS_QUEUE_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=512mb
# Queue: BullMQ, events:price stream, rate limits (noeviction, AOF)
REDIS_QUEUE_URL=redis://localhost:6379
# Cache: search and lookup caches (allkeys-lru, no persistence)
REDIS_CACHE_URL=redis://localhost:6380
